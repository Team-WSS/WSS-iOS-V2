#!/bin/sh
# commit-msg — 커밋 양식 `[Type] #이슈 - 내용`을 사람 경로(Xcode/터미널 직접 커밋)에도 강제
#
# 에이전트 경로는 commit 스킬·new-issue 스크립트가 이미 양식을 강제하지만, 사람이 직접
# 커밋하면 무방비였다(레포에 `Feat#92`·소문자 `chore` 같은 위반 사례가 실제로 존재).
# 이 훅이 인간·에이전트 양쪽을 같은 규약에 묶는다.
#
# Type 화이트리스트는 .claude/skills/commit-types.md 가 단일 진실 소스 —
# new-issue.sh 와 동일하게 런타임에 표를 파싱한다(수동 동기화 불필요).
#
# fail-open 정책: 표 파일이 없거나 파싱이 깨지면 경고만 내고 통과시킨다.
# (여기서 fail-loud 하면 표가 깨진 순간 모든 커밋이 막힌다 — 규약 강제 장치가
#  사람 작업 전체를 볼모로 잡지 않게 한다. 표 자체의 무결성은 new-issue.sh 가
#  fail-loud 로 잡아준다.)
#
# 활성화: git config core.hooksPath .githooks  (클론 후 1회, /setup 이 안내)

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# 제목 = 주석/빈 줄을 제외한 첫 줄
subject=$(grep -v '^#' "$msg_file" | sed '/^[ 	]*$/d' | head -n1)
[ -n "$subject" ] || exit 0   # 빈 메시지는 git 이 스스로 거부한다

# git 관례 메시지는 검사하지 않는다 (자동 생성 머지·리버트·rebase 산출물)
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

# Type 화이트리스트 파싱 (단일 진실 소스: commit-types.md 표의 백틱 첫 칼럼)
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
types_file="$root/.claude/skills/commit-types.md"
if [ ! -f "$types_file" ]; then
  echo "⚠️  commit-msg 훅: Type 표($types_file)가 없어 양식 검사를 건너뜁니다." >&2
  exit 0
fi
allowed=$(grep -oE '^\| `[A-Za-z]+`' "$types_file" | grep -oE '[A-Za-z]+' | tr '\n' '|' | sed 's/|$//')
if [ -z "$allowed" ]; then
  echo "⚠️  commit-msg 훅: Type 표 파싱 실패 — 양식 검사를 건너뜁니다. commit-types.md 표 형식을 확인하세요." >&2
  exit 0
fi

# 양식 검증: [Type] #이슈번호 - 내용
if printf '%s' "$subject" | grep -qE "^\[($allowed)\] #[0-9]+ - .+"; then
  exit 0
fi

echo "❌ 커밋 메시지가 프로젝트 양식과 다릅니다." >&2
echo "" >&2
echo "   입력:  $subject" >&2
echo "   양식:  [Type] #이슈번호 - 한글 설명   (예: [Fix] #132 - 작품 평가 뒤로가기 경합 수정)" >&2
echo "   Type:  $(printf '%s' "$allowed" | tr '|' ' ')" >&2
echo "" >&2
echo "   Type 표: .claude/skills/commit-types.md / 규약: docs/WORKFLOW.md" >&2
exit 1
